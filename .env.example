# Local development environment variables
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob (server-side only)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# Model artifact location (used by predev/prebuild fetch script)
MODEL_ARTIFACT_URL=https://<your-blob-url>/placement-model-artifact.json

# Training dataset location (used by npm run train:model)
TRAINING_DATA_URL=https://<your-blob-url>/placement-training-data.json
